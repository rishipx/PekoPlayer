{
  "name": "pekoplayer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-native video player with on-device transcript search, WebGL2 effects, and multi-view tiling.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node tools/check.mjs",
    "build": "node tools/build.mjs",
    "build:pages": "node tools/build.mjs --csp-meta",
    "serve": "node tools/serve.mjs dist 8080 dist/_headers",
    "desktop:prepare": "node tools/build.mjs && node desktop/prepare.mjs",
    "desktop:start": "npm run desktop:prepare && npm --prefix desktop ci && npm --prefix desktop start",
    "desktop:dist": "npm run desktop:prepare && npm --prefix desktop ci && npm --prefix desktop run dist",
    "fonts:vendor": "node tools/vendor-fonts.mjs",
    "icons:lucide": "node tools/vendor-icons.mjs",
    "icons": "node tools/make-icons.mjs",
    "docs:screenshots": "node tools/screenshots.mjs",
    "test:fixtures": "node tests/fixtures/make-fixtures.mjs",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:browsers": "node tests/smoke/browsers.mjs",
    "test": "npm run lint && npm run format:check && npm run check && npm run test:unit && npm run build && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "lucide-static": "^1.61.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video-player",
    "pwa",
    "webgl2",
    "subtitles",
    "transcript-search",
    "picture-in-picture"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishipx/PekoPlayer.git"
  }
}
